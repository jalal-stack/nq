# Copy to .env. Never commit real keys.
TRADEMIND_ENVIRONMENT=dev
TRADEMIND_STARTING_EQUITY=5000
TRADEMIND_BASE_CURRENCY=USD
# Only "paper" is accepted; any other value fails at startup.
TRADEMIND_TRADING_MODE=paper
TRADEMIND_MAX_RISK_PER_TRADE=0.01
TRADEMIND_MAX_DAILY_LOSS=0.03
TRADEMIND_MAX_DRAWDOWN=0.15
# Browser origins allowed to call the API (comma-separated). On the VPS set your Vercel URL.
TRADEMIND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRADEMIND_WS_PUSH_INTERVAL_SECONDS=5
# Gunicorn (VPS)
TRADEMIND_BIND=127.0.0.1:8000
TRADEMIND_WORKERS=2
