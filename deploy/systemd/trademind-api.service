[Unit]
Description=TradeMind AI API (FastAPI, paper trading only)
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=trademind
Group=trademind
WorkingDirectory=/opt/trademind/backend
EnvironmentFile=/etc/trademind/trademind.env
ExecStart=/opt/trademind/.venv/bin/gunicorn trademind.api.main:app -c /opt/trademind/backend/gunicorn.conf.py
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/trademind/var
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=2G

[Install]
WantedBy=multi-user.target
